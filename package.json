{
  "name": "oneshot-sansui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "capture:readme": "node scripts/capture-readme-gifs.mjs",
    "build:android": "tsc -b && vite build",
    "cap:sync": "node scripts/build-android.mjs && npx cap sync android",
    "android:apk": "npm run cap:sync && node scripts/assemble-debug.mjs",
    "android:install": "npm run android:apk && node scripts/adb-install.mjs",
    "android:open": "npx cap open android",
    "preview:host": "npm run build && vite preview --host --port 4173"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
